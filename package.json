{
  "name": "footsteps",
  "version": "0.1.0",
  "private": true,
  "description": "Embeddable behavior analytics. Import one script; it watches how people use a page and reports it to a local dashboard.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "bridge": "node --disable-warning=ExperimentalWarning --import tsx bridge/server.ts",
    "demo": "node scripts/demo-server.mjs",
    "start": "node scripts/build.mjs && npm run bridge",
    "build:server": "esbuild bridge/server.ts --bundle --platform=node --format=esm --target=node22 --outfile=build/server.mjs --log-level=warning",
    "start:prod": "node --disable-warning=ExperimentalWarning build/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/build.mjs && playwright test",
    "smoke": "node scripts/smoke.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check:perf": "node scripts/build.mjs && node scripts/check-size.mjs && node scripts/bench.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@sentry/browser": "^8.55.2",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "happy-dom": "^15.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "vue": "^3.5.44",
    "zone.js": "^0.16.3"
  },
  "dependencies": {
    "web-vitals": "^4.2.4"
  }
}
